# Copy to .env and fill in. Never commit .env.

# --- Database (matches docker-compose.yml defaults) ---
POSTGRES_USER=entrostic
POSTGRES_PASSWORD=entrostic
POSTGRES_DB=entrostic
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://entrostic:entrostic@localhost:5433/entrostic

# --- AI (used from Step 3 onward) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- App ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
SESSION_DAYS=14
# Set to true in production (HTTPS only)
COOKIE_SECURE=false
